# Smart Rental — Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local or any file containing real secrets to Git.

# ─── Supabase (Frontend — safe to expose in browser) ────────────────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ─── Resend (Server-side ONLY — must NOT have VITE_ prefix) ──────────────────
# Used only in TanStack Start server functions. Never exposed to the browser.
RESEND_API_KEY=re_your_resend_api_key_here

# ─── Email Notification Settings ─────────────────────────────────────────────
# The "from" address must be a verified domain in your Resend account.
RESEND_FROM_EMAIL=alerts@your-domain.com
RESEND_FROM_NAME=Smart Rental Alerts

# ─── App Settings ─────────────────────────────────────────────────────────────
# Base URL of your deployment (used for email CTAs)
APP_BASE_URL=http://localhost:5173
