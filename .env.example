# Smart Rental — environment variables
#
# Copy this file to `.env.local` for local development and fill in real
# values there. `.env.local` is git-ignored — never commit real secrets.
#
# Vite only exposes variables prefixed VITE_ to the browser bundle. Any
# variable WITHOUT that prefix (e.g. RESEND_API_KEY) is a server-only /
# Supabase Edge Function secret and must never be added with a VITE_ prefix.

# ── Client (safe to expose — Supabase anon key is protected by Row Level
#    Security policies, not by secrecy) ──────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Server-only — Supabase Edge Function secrets ─────────────────────────
# Set these with `supabase secrets set KEY=value`, NOT in this file's real
# form and NOT as VITE_ variables. They are read only inside
# supabase/functions/send-alert-email and are never bundled into the
# browser build.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
PUBLIC_APP_URL=

# Supplied automatically inside every Supabase Edge Function runtime — do
# not set these yourself for local `vite dev`, they only apply to
# `supabase functions serve` / deployed functions:
#   SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY
